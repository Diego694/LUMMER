{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "assets/js/**/*.js",
    "assets/js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "legacy",
    "desktop",
    "android",
    "tests"
  ]
}
